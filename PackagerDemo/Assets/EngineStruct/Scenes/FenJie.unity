--- !u!114 &1868338279
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1868338277}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: a839bd750521d0c40ba93809556be299, type: 3}
    m_FontSize: 19
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 1
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\u98CE\u6247\u53F6\u7247\u662FCFM56\u53D1\u52A8\u673A\u6700\u663E\u8457\u7684\u5916\u90E8\u7279\u5F81\uFF0C\u4F5C\u4E3A\u9AD8\u6DB5\u9053\u6BD4\u6DA1\u6247\u53D1\u52A8\u673A\u7684\u6838\u5FC3\u90E8\u4EF6\uFF0C\u5176\u8BBE\u8BA1\u76F4\u63A5\u5F71\u54CD\u53D1\u52A8\u673A\u7684\u63A8\u529B\u3001\u71C3\u6CB9\u6548\u7387\u548C\u566A\u58F0\u6C34\u5E73\u3002\r\n1.
    \u57FA\u672C\u529F\u80FD\r\n\u4E3B\u8981\u4F5C\u7528\uFF1A\r\n\u4EA7\u751F\u53D1\u52A8\u673A80%\u4EE5\u4E0A\u7684\u603B\u63A8\u529B\uFF08\u901A\u8FC7\u5916\u6DB5\u9053\u6C14\u6D41\uFF09\r\n\u4E3A\u4F4E\u538B\u538B\u6C14\u673A\uFF08LPC\uFF09\u63D0\u4F9B\u9884\u538B\u7F29\u7A7A\u6C14\r\n\u5F71\u54CD\u53D1\u52A8\u673A\u7684\u71C3\u6CB9\u7ECF\u6D4E\u6027\u548C\u566A\u58F0\u7279\u6027\r\n\u6C14\u6D41\u5206\u914D\uFF1A\r\n\u7EA680%\u6C14\u6D41\u8FDB\u5165\u5916\u6DB5\u9053\uFF08\u4EA7\u751F\u63A8\u529B\uFF09\r\n\u7EA620%\u6C14\u6D41\u8FDB\u5165\u6838\u5FC3\u673A\uFF08\u53C2\u4E0E\u71C3\u70E7\uFF09\r\n2.
    \u6838\u5FC3\u8BBE\u8BA1\u7279\u70B9\r\n1) \u5BBD\u5F26\u8BBE\u8BA1\uFF08-5B/7B\uFF09\uFF1A\r\n\u5F26\u957F\u589E\u52A020-30%\r\n\u4F18\u70B9\uFF1A\r\n\u63D0\u9AD8\u6C14\u52A8\u6548\u7387\r\n\u589E\u5F3A\u6297\u5916\u7269\u635F\u4F24\uFF08FOD\uFF09\u80FD\u529B\r\n\u51CF\u5C11\u53F6\u7247\u6570\u91CF\uFF08\u4ECE38\u7247\u51CF\u81F336\u7247\uFF09\r\n2)
    \u7A7A\u5FC3\u7ED3\u6784\uFF1A\r\n\u949B\u5408\u91D1\u8702\u7A9D\u5939\u5C42\u7ED3\u6784\r\n\u51CF\u91CD15-20%\r\n\u4FDD\u6301\u7ED3\u6784\u521A\u5EA6\r\n3)
    \u4E09\u7EF4\u6C14\u52A8\u9020\u578B\uFF1A\r\n\u63A0\u5F62\u524D\u7F18\u8BBE\u8BA1\r\n\u53D8\u622A\u9762\u626D\u8F6C\u53F6\u7247\r\n\u4F18\u5316\u8DE8\u97F3\u901F\u6D41\u52A8\r\n3.
    \u6750\u6599\u6280\u672F\r\n\u4E3B\u4F53\u6750\u6599\uFF1A\r\nTi-6Al-4V\u949B\u5408\u91D1\uFF08\u517C\u987E\u5F3A\u5EA6\u4E0E\u91CD\u91CF\uFF09\r\n\u7279\u6B8A\u5904\u7406\uFF1A\r\n\u524D\u7F18\u8010\u78E8\u6D82\u5C42\uFF08\u954D\u94EC\u5408\u91D1\uFF09\r\n\u9632\u8150\u8680\u9633\u6781\u6C27\u5316\u5904\u7406\r\n\u96F7\u51FB\u9632\u62A4\uFF08\u94DC\u7F51\u690D\u5165\uFF09\r\n\u672A\u6765\u8D8B\u52BF\uFF1A\r\nLEAP\u53D1\u52A8\u673A\u91C7\u7528\u78B3\u7EA4\u7EF4\u590D\u5408\u6750\u6599\uFF08CFM56\u4ECD\u575A\u6301\u949B\u5408\u91D1\uFF09\r\n4.
    \u5236\u9020\u5DE5\u827A\r\n\u7CBE\u5BC6\u953B\u9020\uFF1A\r\n\u4E07\u5428\u7EA7\u6DB2\u538B\u673A\u6210\u578B\r\n\u8D85\u5851\u6210\u5F62/\u6269\u6563\u8FDE\u63A5\uFF08SPF/DB\uFF09\u5DE5\u827A\r\n\u673A\u68B0\u52A0\u5DE5\uFF1A\r\n\u4E94\u8F74\u6570\u63A7\u94E3\u524A\u590D\u6742\u578B\u9762\r\n\u6FC0\u5149\u6253\u6807\u8FFD\u8E2A\r\n\u8D28\u91CF\u68C0\u6D4B\uFF1A\r\n\u8D85\u58F0\u6CE2\u63A2\u4F24\r\nX\u5C04\u7EBF\u68C0\u6D4B\u5185\u90E8\u7ED3\u6784\r\n\u52A8\u5E73\u8861\u6D4B\u8BD5\r\n5.
    \u7EF4\u62A4\u4E0E\u635F\u4F24\u9632\u62A4\r\n\u5E38\u89C1\u95EE\u9898\uFF1A\r\n\u5916\u7269\u635F\u4F24\uFF08FOD\uFF09\uFF1A\u8DD1\u9053\u5F02\u7269\u3001\u9E1F\u51FB\r\n\u524D\u7F18\u8150\u8680\uFF1A\u6F6E\u6E7F/\u76D0\u96FE\u73AF\u5883\r\n\u96F7\u51FB\u635F\u4F24\uFF1A\u6BCF\u5343\u98DE\u884C\u5C0F\u65F6\u7EA60.3\u6B21\r\n\u7EF4\u62A4\u63AA\u65BD\uFF1A\r\n\u65E5\u5E38\u76EE\u89C6\u68C0\u67E5\uFF08\u524D\u7F18\u7F3A\u53E3/\u8150\u8680\uFF09\r\n\u5B9A\u671F\u6DA1\u6D41\u68C0\u6D4B\uFF08\u5185\u90E8\u7F3A\u9677\uFF09\r\n\u73B0\u573A\u4FEE\u590D\u6280\u672F\uFF1A\r\n\u524D\u7F18\u8010\u78E8\u5E26\u66F4\u6362\r\n\u6FC0\u5149\u7194\u8986\u4FEE\u590D\r\n6.
    \u58F0\u5B66\u8BBE\u8BA1\r\n\u964D\u566A\u7279\u5F81\uFF1A\r\n\u63A0\u5F62\u524D\u7F18\u51CF\u5C11\u6FC0\u6CE2\u566A\u58F0\r\n\u975E\u5747\u5300\u53F6\u7247\u95F4\u8DDD\uFF08-7B\uFF09\r\n\u5438\u97F3\u886C\u5957\uFF08\u8FDB\u6C14\u9053\uFF09\r\n\u566A\u58F0\u6C34\u5E73\uFF1A\r\n\u6BD4\u65E9\u671F\u578B\u53F7\u964D\u4F4E15-20dB\r\n\u6EE1\u8DB3ICAO\u3000Chapter
    4\u6807\u51C6\r\n\u6280\u672F\u610F\u4E49\r\nCFM56\u7684\u98CE\u6247\u53F6\u7247\u8BBE\u8BA1\u4F53\u73B0\u4E86\uFF1A\r\n\u53EF\u9760\u6027\uFF1A\u7D2F\u8BA1\u8D8510\u4EBF\u98DE\u884C\u5C0F\u65F6\u9A8C\u8BC1\r\n\u7ECF\u6D4E\u6027\uFF1A\u7EF4\u62A4\u5468\u671F\u8FBE20,000\u5C0F\u65F6\r\n\u9002\u5E94\u6027\uFF1A\u5168\u7403\u5404\u79CD\u6C14\u5019\u6761\u4EF6\u7A33\u5B9A\u8FD0\u884C\r\n\u4F5C\u4E3A\u9AD8\u6DB5\u9053\u6BD4\u53D1\u52A8\u673A\u7684\u6807\u5FD7\u6027\u8BBE\u8BA1\uFF0C\u5176\u6280\u672F\u6F14\u8FDB\u4E3A\u540E\u7EEDLEAP\u53D1\u52A8\u673A\u7684\u590D\u5408\u6750\u6599\u98CE\u6247\u79EF\u7D2F\u4E86\u5B9D\u8D35\u7ECF\u9A8C\uFF0C\u540C\u65F6\u4FDD\u6301\u949B\u5408\u91D1\u8BBE\u8BA1\u7684\u6210\u719F\u53EF\u9760\u6027\uFF0C\u8FD9\u4E5F\u662FCFM56\u80FD\u6210\u4E3A\u6C11\u822A\u53F2\u4E0A\u6700\u6210\u529F\u53D1\u52A8\u673A\u4E4B\u4E00\u7684\u5173\u952E\u56E0\u7D20\u3002"
