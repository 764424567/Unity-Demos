--- !u!114 &181200898
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 181200896}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: a839bd750521d0c40ba93809556be299, type: 3}
    m_FontSize: 19
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 1
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\u4F4E\u538B\u538B\u6C14\u673A\u662FCFM56\u53D1\u52A8\u673A\u7684\u91CD\u8981\u90E8\u4EF6\uFF0C\u4F5C\u4E3A\u53CC\u8F6C\u5B50\u7ED3\u6784\u4E2D\u7684\u4F4E\u538B\u90E8\u5206\uFF0C\u4E3B\u8981\u8D1F\u8D23\u4E3A\u9AD8\u538B\u538B\u6C14\u673A\u63D0\u4F9B\u9884\u538B\u7F29\u7A7A\u6C14\uFF0C\u5E76\u9A71\u52A8\u53D1\u52A8\u673A\u5916\u6DB5\u9053\u4EA7\u751F\u5927\u90E8\u5206\u63A8\u529B\u3002\r\n1.
    \u57FA\u672C\u529F\u80FD\u4E0E\u5B9A\u4F4D\r\n\u6838\u5FC3\u529F\u80FD\uFF1A\r\n\u5BF9\u8FDB\u6C14\u8FDB\u884C\u521D\u6B65\u538B\u7F29\uFF08\u538B\u6BD4\u7EA61.5-2:1\uFF09\r\n\u4E3A\u9AD8\u538B\u538B\u6C14\u673A\uFF08HPC\uFF09\u63D0\u4F9B\u7A33\u5B9A\u6C14\u6D41\r\n\u9A71\u52A8\u5916\u6DB5\u9053\u98CE\u6247\u4EA7\u751F\u7EA680%\u7684\u603B\u63A8\u529B\r\n\u7CFB\u7EDF\u5173\u8054\uFF1A\r\n\u4E0E\u98CE\u6247\u540C\u8F74\uFF08\u4F4E\u538B\u8F6C\u5B50\uFF09\r\n\u901A\u8FC7\u4F4E\u538B\u6DA1\u8F6E\uFF08LPT\uFF09\u9A71\u52A8\r\n\u6C14\u6D41\u5206\u6D41\uFF1A\u90E8\u5206\u8FDB\u5165\u6838\u5FC3\u673A\uFF0C\u90E8\u5206\u8FDB\u5165\u5916\u6DB5\u9053\r\n2.
    \u7ED3\u6784\u8BBE\u8BA1\r\n\u5178\u578B\u914D\u7F6E\uFF1A\r\nCFM56-3\uFF1A3\u7EA7\u4F4E\u538B\u538B\u6C14\u673A\r\nCFM56-5B/7B\uFF1A4\u7EA7\u4F4E\u538B\u538B\u6C14\u673A\uFF08\u4F18\u5316\u6548\u7387\uFF09\r\n\u6838\u5FC3\u7EC4\u4EF6\uFF1A\r\n\u8F6C\u5B50\u7CFB\u7EDF\uFF1A\r\n\u949B\u5408\u91D1\u53F6\u7247\uFF08\u524D\u7EA7\uFF09\u4E0E\u94A2\u5236\u8F6E\u76D8\r\n\u5BBD\u5F26\u8BBE\u8BA1\uFF08\u65B0\u578B\u53F7\uFF09\u63D0\u5347\u6297\u5F02\u7269\u635F\u4F24\u80FD\u529B\r\n\u9759\u5B50\u7CFB\u7EDF\uFF1A\r\n\u56FA\u5B9A\u5BFC\u5411\u53F6\u7247\uFF08\u5B9A\u5B50\uFF09\r\n\u53EF\u8C03\u8FDB\u53E3\u5BFC\u6D41\u53F6\u7247\uFF08IGV\uFF09\u4F18\u5316\u4F4E\u901F\u6027\u80FD\r\n\u673A\u5323\u7ED3\u6784\uFF1A\r\n\u94DD\u5408\u91D1\u6216\u590D\u5408\u6750\u6599\u58F3\u4F53\r\n\u9632\u51B0\u7CFB\u7EDF\uFF08\u524D\u7F18\u7535\u52A0\u70ED\u6216\u5F15\u6C14\u52A0\u70ED\uFF09\r\n3.
    \u5DE5\u4F5C\u539F\u7406\r\n\u6C14\u6D41\u8DEF\u5F84\uFF1A\r\n\u8FDB\u6C14\u2192\u98CE\u6247\u2192\u4F4E\u538B\u538B\u6C14\u673A\u2192\u5206\u6D41\uFF08\u5916\u6DB5\u9053/\u6838\u5FC3\u673A\uFF09\r\n\u538B\u7F29\u8FC7\u7A0B\uFF1A\r\n\u6BCF\u7EA7\u8F6C\u5B50\u52A0\u901F\u6C14\u6D41\uFF0C\u9759\u5B50\u5C06\u52A8\u80FD\u8F6C\u4E3A\u538B\u529B\u80FD\r\n\u6D41\u91CF\u63A7\u5236\uFF1A\r\nIGV\u8C03\u8282\u8FDB\u6C14\u89D2\u5EA6\r\n\u653E\u6C14\u6D3B\u95E8\u9632\u6B62\u5598\u632F\uFF08\u4E2D\u540E\u671F\u578B\u53F7\uFF09\r\n4.
    \u5173\u952E\u6280\u672F\u7279\u5F81\r\n\u5BBD\u5F26\u98CE\u6247\u53F6\u7247\uFF08-5B/7B\uFF09\uFF1A\r\n\u63D0\u5347\u6C14\u52A8\u6548\u7387\r\n\u589E\u5F3A\u6297\u5916\u7269\u635F\u4F24\uFF08FOD\uFF09\u80FD\u529B\r\n\u4E09\u7EF4\u6C14\u52A8\u8BBE\u8BA1\uFF1A\r\n\u4F18\u5316\u53F6\u578B\u51CF\u5C11\u6D41\u52A8\u5206\u79BB\r\n\u590D\u5408\u6750\u6599\u5E94\u7528\uFF1A\r\n\u540E\u671F\u578B\u53F7\u91C7\u7528\u590D\u5408\u6750\u6599\u673A\u5323\u51CF\u91CD\r\n5.
    \u6027\u80FD\u53C2\u6570\r\n\u53C2\u6570\u3000\u3000\u5178\u578B\u503C\r\n\u7EA7\u6570\u3000\u30003-4\u7EA7\r\n\u538B\u6BD4\u3000\u30001.5-2:1\r\n\u8F6C\u901F\u3000\u30002,000-5,000
    RPM\r\n\u6548\u7387\u3000\u300088-92%\r\n\u6D41\u91CF\u3000\u30001,000-1,300
    lb/s\r\n6. \u6750\u6599\u4E0E\u5236\u9020\r\n\u53F6\u7247\uFF1A\r\n\u949B\u5408\u91D1\uFF08Ti-6Al-4V\uFF09\u4E3B\u4F53\r\n\u524D\u7F18\u8010\u78E8\u6D82\u5C42\uFF08\u954D\u94EC\u5408\u91D1\uFF09\r\n\u8F6E\u76D8\uFF1A\r\n\u9AD8\u5F3A\u5EA6\u94A2\u953B\u4EF6\r\n\u673A\u5323\uFF1A\r\n\u94DD\u5408\u91D1\uFF08\u65E9\u671F\uFF09\u2192
    \u590D\u5408\u6750\u6599\uFF08\u540E\u671F\uFF09\r\n7. \u7EF4\u62A4\u8981\u70B9\r\n\u5E38\u89C1\u95EE\u9898\uFF1A\r\n\u524D\u7EA7\u53F6\u7247FOD\u635F\u4F24\r\n\u7ED3\u51B0\u5BFC\u81F4\u6C14\u6D41\u7578\u53D8\r\n\u8F74\u627F\u78E8\u635F\u5F15\u8D77\u632F\u52A8\r\n\u7EF4\u62A4\u63AA\u65BD\uFF1A\r\n\u5B9A\u671F\u5B54\u63A2\u68C0\u67E5\r\n\u53F6\u7247\u524D\u7F18\u4FEE\u590D\r\n\u632F\u52A8\u76D1\u6D4B\u5206\u6790\r\n8.
    \u578B\u53F7\u6F14\u8FDB\r\nCFM56-3\uFF1A\r\n3\u7EA7\u4F20\u7EDF\u8BBE\u8BA1\r\n\u673A\u68B0\u5F0F\u63A7\u5236\u7CFB\u7EDF\r\nCFM56-5B\uFF1A\r\n\u5F15\u5165\u5BBD\u5F26\u53F6\u7247\r\n\u6539\u8FDB\u6C14\u52A8\u8BBE\u8BA1\r\nCFM56-7B\uFF1A\r\n4\u7EA7\u4F18\u5316\u5E03\u5C40\r\n\u590D\u5408\u6750\u6599\u90E8\u4EF6\u5E94\u7528\r\n\u6280\u672F\u610F\u4E49\u4E0E\u53D1\u5C55\r\n\u4F4E\u538B\u538B\u6C14\u673A\u7684\u6301\u7EED\u6539\u8FDB\u4F53\u73B0\u4E86CFM56\u7CFB\u5217\u7684\u6280\u672F\u6F14\u8FDB\uFF1A\r\n\u4ECE\u4F20\u7EDF\u8BBE\u8BA1\u5411\u9AD8\u6548\u6C14\u52A8\u5E03\u5C40\u53D1\u5C55\r\n\u6750\u6599\u5347\u7EA7\u5E26\u6765\u51CF\u91CD\u548C\u53EF\u9760\u6027\u63D0\u5347\r\n\u4E3A\u540E\u7EEDLEAP\u53D1\u52A8\u673A\u7684\u5148\u8FDB\u590D\u5408\u6750\u6599\u98CE\u6247\u5960\u5B9A\u57FA\u7840\r\n\u4F5C\u4E3A\u9AD8\u6DB5\u9053\u6BD4\u6DA1\u6247\u53D1\u52A8\u673A\u7684\u5173\u952E\u90E8\u4EF6\uFF0C\u4F4E\u538B\u538B\u6C14\u673A\u7684\u8BBE\u8BA1\u5E73\u8861\u4E86\uFF1A\r\n\u6C14\u52A8\u6548\u7387\r\n\u7ED3\u6784\u5F3A\u5EA6\r\n\u7EF4\u62A4\u7ECF\u6D4E\u6027\r\n\u5176\u7A33\u5B9A\u53EF\u9760\u7684\u6027\u80FD\u662FCFM56\u6210\u4E3A\u6C11\u822A\u4E3B\u529B\u53D1\u52A8\u673A\u7684\u91CD\u8981\u56E0\u7D20\u4E4B\u4E00\u3002"
