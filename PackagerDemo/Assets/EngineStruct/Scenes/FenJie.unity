--- !u!114 &1576980556
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1576980554}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: a839bd750521d0c40ba93809556be299, type: 3}
    m_FontSize: 19
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 1
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\u71C3\u6CB9\u55B7\u5634\uFF08Fuel\u3000Nozzle\uFF09\u662FCFM56\u53D1\u52A8\u673A\u71C3\u6CB9\u7CFB\u7EDF\u7684\u6838\u5FC3\u90E8\u4EF6\u4E4B\u4E00\uFF0C\u8D1F\u8D23\u5C06\u71C3\u6CB9\u96FE\u5316\u5E76\u55B7\u5165\u71C3\u70E7\u5BA4\uFF0C\u786E\u4FDD\u9AD8\u6548\u3001\u7A33\u5B9A\u7684\u71C3\u70E7\u3002\u5176\u8BBE\u8BA1\u76F4\u63A5\u5F71\u54CD\u53D1\u52A8\u673A\u7684\u71C3\u70E7\u6548\u7387\u3001\u6392\u653E\u6027\u80FD\u53CA\u53EF\u9760\u6027\u3002\r\n1.
    \u57FA\u672C\u529F\u80FD\r\n\u71C3\u6CB9\u96FE\u5316\uFF1A\u5C06\u9AD8\u538B\u71C3\u6CB9\u7834\u788E\u6210\u7EC6\u5C0F\u6DB2\u6EF4\uFF0C\u589E\u5927\u4E0E\u7A7A\u6C14\u7684\u63A5\u89E6\u9762\u79EF\uFF0C\u4FC3\u8FDB\u5145\u5206\u71C3\u70E7\u3002\r\n\u71C3\u6CB9\u5206\u5E03\u63A7\u5236\uFF1A\u786E\u4FDD\u71C3\u6CB9\u5747\u5300\u55B7\u5165\u71C3\u70E7\u5BA4\uFF0C\u907F\u514D\u5C40\u90E8\u9AD8\u6E29\u6216\u71C3\u70E7\u4E0D\u5B8C\u5168\u3002\r\n\u51B7\u5374\u4FDD\u62A4\uFF1A\u90E8\u5206\u71C3\u6CB9\u7528\u4E8E\u51B7\u5374\u55B7\u5634\u81EA\u8EAB\uFF0C\u9632\u6B62\u9AD8\u6E29\u71C3\u6C14\u5BFC\u81F4\u70ED\u635F\u4F24\u3002\r\n2.
    \u4E3B\u8981\u7ED3\u6784\r\nCFM56\u7684\u71C3\u6CB9\u55B7\u5634\u901A\u5E38\u91C7\u7528**\u7A7A\u6C14\u96FE\u5316\u5F0F\uFF08Airblast
    Atomizer\uFF09**\u8BBE\u8BA1\uFF0C\u4E3B\u8981\u7EC4\u6210\u90E8\u5206\u5305\u62EC\uFF1A\r\n\u71C3\u6CB9\u5165\u53E3\uFF1A\u63A5\u6536\u6765\u81EA\u71C3\u6CB9\u6CF5\u7684\u9AD8\u538B\u71C3\u6CB9\uFF08\u538B\u529B\u53EF\u8FBE500\u20133000psi\uFF0C\u53D6\u51B3\u4E8E\u5DE5\u51B5\uFF09\u3002\r\n\u65CB\u6D41\u8154\uFF1A\u71C3\u6CB9\u901A\u8FC7\u65CB\u6D41\u5668\u4EA7\u751F\u65CB\u8F6C\uFF0C\u589E\u5F3A\u96FE\u5316\u6548\u679C\u3002\r\n\u7A7A\u6C14\u901A\u9053\uFF1A\u5F15\u5165\u9AD8\u538B\u538B\u6C14\u673A\u7684\u7A7A\u6C14\uFF08\u4E8C\u7EA7\u6216\u4E09\u7EA7\u5F15\u6C14\uFF09\uFF0C\u4E0E\u71C3\u6CB9\u6DF7\u5408\u5E76\u8FDB\u4E00\u6B65\u96FE\u5316\u3002\r\n\u55B7\u5634\u5934\u90E8\uFF1A\u91C7\u7528\u8010\u9AD8\u6E29\u5408\u91D1\uFF08\u5982Hastelloy\u6216Inconel\uFF09\uFF0C\u5E26\u6709\u7CBE\u5BC6\u55B7\u5B54\uFF0C\u786E\u4FDD\u71C3\u6CB9\u5747\u5300\u55B7\u5C04\u3002\r\n\u5BC6\u5C01\u4E0E\u9694\u70ED\uFF1A\u91C7\u7528\u77F3\u58A8\u6216\u91D1\u5C5E\u5BC6\u5C01\u73AF\uFF0C\u9632\u6B62\u71C3\u6C14\u6CC4\u6F0F\uFF0C\u90E8\u5206\u578B\u53F7\u5E26\u6709\u70ED\u969C\u6D82\u5C42\uFF08TBC\uFF09\u3002\r\n3.
    \u5DE5\u4F5C\u539F\u7406\r\n\u71C3\u6CB9\u52A0\u538B\uFF1A\u71C3\u6CB9\u7ECF\u9AD8\u538B\u71C3\u6CB9\u6CF5\u589E\u538B\u540E\u8FDB\u5165\u55B7\u5634\u3002\r\n\u65CB\u6D41\u96FE\u5316\uFF1A\u71C3\u6CB9\u5728\u65CB\u6D41\u8154\u5185\u9AD8\u901F\u65CB\u8F6C\uFF0C\u5F62\u6210\u8584\u6DB2\u819C\u3002\r\n\u7A7A\u6C14\u8F85\u52A9\u96FE\u5316\uFF1A\u9AD8\u538B\u7A7A\u6C14\u4ECE\u55B7\u5634\u73AF\u7F1D\u55B7\u51FA\uFF0C\u5C06\u71C3\u6CB9\u6DB2\u819C\u6495\u88C2\u6210\u5FAE\u5C0F\u6DB2\u6EF4\uFF08\u76F4\u5F84\u7EA620\u2013100\u5FAE\u7C73\uFF09\u3002\r\n\u55B7\u5C04\u8FDB\u5165\u71C3\u70E7\u5BA4\uFF1A\u96FE\u5316\u71C3\u6CB9\u4E0E\u71C3\u70E7\u5BA4\u5185\u7684\u9AD8\u6E29\u9AD8\u538B\u7A7A\u6C14\u6DF7\u5408\uFF0C\u5B9E\u73B0\u7A33\u5B9A\u71C3\u70E7\u3002\r\n4.
    \u5173\u952E\u8BBE\u8BA1\u7279\u70B9\r\n\u53CC\u8DEF\u4F9B\u6CB9\uFF08\u90E8\u5206\u578B\u53F7\uFF09\uFF1A\r\n\u4E3B\u6CB9\u8DEF\uFF1A\u9AD8\u529F\u7387\u72B6\u6001\u4E0B\u4F9B\u6CB9\u3002\r\n\u526F\u6CB9\u8DEF\uFF1A\u4F4E\u529F\u7387\u72B6\u6001\u4E0B\u4F9B\u6CB9\uFF0C\u4F18\u5316\u71C3\u6CB9\u7ECF\u6D4E\u6027\u3002\r\n\u9632\u79EF\u78B3\u8BBE\u8BA1\uFF1A\u4F18\u5316\u55B7\u5B54\u5F62\u72B6\u548C\u6C14\u6D41\u7EC4\u7EC7\uFF0C\u51CF\u5C11\u71C3\u6CB9\u6B8B\u7559\u548C\u79EF\u78B3\u3002\r\n\u81EA\u6E05\u6D01\u80FD\u529B\uFF1A\u90E8\u5206\u55B7\u5634\u91C7\u7528\u8109\u51B2\u55B7\u5C04\u6216\u7A7A\u6C14\u51B2\u5237\u8BBE\u8BA1\uFF0C\u51CF\u5C11\u7ED3\u7126\u3002\r\n5.
    \u6750\u6599\u4E0E\u5236\u9020\r\n\u8010\u9AD8\u6E29\u5408\u91D1\uFF1A\u55B7\u5634\u5934\u90E8\u91C7\u7528\u954D\u57FA\u5408\u91D1\uFF08\u5982Inconel
    718\uFF09\u4EE5\u627F\u53D7\u71C3\u70E7\u5BA4\u9AD8\u6E29\uFF08\u7EA6800\u20131000\xB0C\uFF09\u3002\r\n\u7CBE\u5BC6\u52A0\u5DE5\uFF1A\u55B7\u5B54\u91C7\u7528\u6FC0\u5149\u94BB\u5B54\u6216\u7535\u706B\u82B1\u52A0\u5DE5\uFF08EDM\uFF09\uFF0C\u786E\u4FDD\u5C3A\u5BF8\u7CBE\u5EA6\uFF08\u516C\u5DEE\xB10.01mm\uFF09\u3002\r\n\u6D82\u5C42\u6280\u672F\uFF1A\u90E8\u5206\u55B7\u5634\u6D82\u8986\u9676\u74F7\u70ED\u969C\u6D82\u5C42\uFF08TBC\uFF09\u6216\u6297\u6C27\u5316\u6D82\u5C42\uFF0C\u5EF6\u957F\u5BFF\u547D\u3002\r\n6.
    \u7EF4\u62A4\u4E0E\u5E38\u89C1\u95EE\u9898\r\n\u79EF\u78B3\u4E0E\u5835\u585E\uFF1A\u957F\u671F\u4F7F\u7528\u53EF\u80FD\u5BFC\u81F4\u55B7\u5B54\u5835\u585E\uFF0C\u9700\u5B9A\u671F\u8D85\u58F0\u6CE2\u6E05\u6D17\u6216\u66F4\u6362\u3002\r\n\u70ED\u75B2\u52B3\u88C2\u7EB9\uFF1A\u9AD8\u6E29\u5FAA\u73AF\u53EF\u80FD\u5BFC\u81F4\u55B7\u5634\u5934\u90E8\u51FA\u73B0\u88C2\u7EB9\uFF0C\u9700\u5B9A\u671F\u63A2\u4F24\u68C0\u6D4B\u3002\r\n\u5BC6\u5C01\u5931\u6548\uFF1A\u77F3\u58A8\u5BC6\u5C01\u73AF\u8001\u5316\u53EF\u80FD\u5BFC\u81F4\u71C3\u6CB9\u6CC4\u6F0F\uFF0C\u9700\u5B9A\u671F\u68C0\u67E5\u66F4\u6362\u3002\r\n\u78E8\u635F\u4E0E\u8150\u8680\uFF1A\u71C3\u6CB9\u4E2D\u7684\u6742\u8D28\u6216\u786B\u5316\u7269\u53EF\u80FD\u52A0\u901F\u55B7\u5634\u8150\u8680\u3002\r\n7.
    \u6539\u8FDB\u578B\u53F7\u5BF9\u6BD4\r\n\u4E0D\u540CCFM56\u5B50\u7CFB\u5217\u7684\u71C3\u6CB9\u55B7\u5634\u8BBE\u8BA1\u6709\u6240\u4F18\u5316\uFF1A\r\nCFM56-3\uFF1A\u65E9\u671F\u673A\u68B0\u96FE\u5316\u55B7\u5634\uFF0C\u7ED3\u6784\u7B80\u5355\u4F46\u6548\u7387\u8F83\u4F4E\u3002\r\nCFM56-5B/-7B\uFF1A\u91C7\u7528\u5148\u8FDB\u7A7A\u6C14\u96FE\u5316\u6280\u672F\uFF0C\u71C3\u70E7\u66F4\u5145\u5206\uFF0C\u964D\u4F4E\u6C61\u67D3\u7269\u6392\u653E\uFF08\u7B26\u5408ICAO
    CAEP\u6807\u51C6\uFF09\u3002\r\n\u603B\u7ED3\r\nCFM56\u7684\u71C3\u6CB9\u55B7\u5634\u662F\u71C3\u70E7\u7CFB\u7EDF\u7684\u5173\u952E\u90E8\u4EF6\uFF0C\u5176\u9AD8\u6548\u7684\u96FE\u5316\u80FD\u529B\u76F4\u63A5\u5F71\u54CD\u53D1\u52A8\u673A\u7684\u71C3\u70E7\u7A33\u5B9A\u6027\u3001\u6392\u653E\u548C\u71C3\u6CB9\u7ECF\u6D4E\u6027\u3002\u901A\u8FC7\u7A7A\u6C14\u96FE\u5316\u6280\u672F\u3001\u8010\u9AD8\u6E29\u6750\u6599\u548C\u7CBE\u5BC6\u5236\u9020\u5DE5\u827A\uFF0CCFM56\u7684\u71C3\u6CB9\u55B7\u5634\u5728\u53EF\u9760\u6027\u548C\u6027\u80FD\u65B9\u9762\u8868\u73B0\u4F18\u5F02\uFF0C\u6210\u4E3A\u5176\u957F\u671F\u5360\u636E\u6C11\u822A\u5E02\u573A\u7684\u91CD\u8981\u56E0\u7D20\u4E4B\u4E00\u3002"
