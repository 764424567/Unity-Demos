--- !u!114 &1999728969
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1999728967}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: a839bd750521d0c40ba93809556be299, type: 3}
    m_FontSize: 19
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 1
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\u9AD8\u538B\u6DA1\u8F6E\uFF08HPT\uFF09\u662FCFM56\u53D1\u52A8\u673A\u7684\u6838\u5FC3\u70ED\u7AEF\u90E8\u4EF6\u4E4B\u4E00\uFF0C\u8D1F\u8D23\u9A71\u52A8\u9AD8\u538B\u538B\u6C14\u673A\uFF08HPC\uFF09\uFF0C\u5E76\u63D0\u53D6\u9AD8\u6E29\u71C3\u6C14\u7684\u80FD\u91CF\u4EE5\u7EF4\u6301\u6838\u5FC3\u673A\u7684\u9AD8\u6548\u8FD0\u8F6C\u3002\u4EE5\u4E0B\u662F\u5176\u5173\u952E\u7279\u70B9\u548C\u5DE5\u4F5C\u539F\u7406\u7684\u8BE6\u7EC6\u4ECB\u7ECD\uFF1A\r\n1.
    \u57FA\u672C\u529F\u80FD\r\n\u80FD\u91CF\u63D0\u53D6\uFF1A\u5C06\u71C3\u70E7\u5BA4\u51FA\u53E3\u7684\u9AD8\u6E29\u9AD8\u538B\u71C3\u6C14\u80FD\u91CF\u8F6C\u5316\u4E3A\u673A\u68B0\u80FD\uFF0C\u9A71\u52A8\u9AD8\u538B\u538B\u6C14\u673A\uFF08HPC\uFF09\u3002\r\n\u7EF4\u6301\u6838\u5FC3\u673A\u8FD0\u8F6C\uFF1A\u4E0E\u9AD8\u538B\u538B\u6C14\u673A\u540C\u8F74\uFF08\u9AD8\u538B\u8F6C\u5B50\uFF09\uFF0C\u8F6C\u901F\u8F83\u9AD8\uFF08\u7EA610,000\u201315,000RPM\uFF09\u3002\r\n\u63A8\u529B\u8D21\u732E\uFF1A\u867D\u7136\u5927\u90E8\u5206\u63A8\u529B\u6765\u81EA\u4F4E\u538B\u6DA1\u8F6E\u9A71\u52A8\u7684\u98CE\u6247\uFF0C\u4F46HPT\u7684\u9AD8\u6548\u5DE5\u4F5C\u76F4\u63A5\u5F71\u54CD\u6838\u5FC3\u673A\u7684\u6027\u80FD\u548C\u71C3\u6CB9\u6548\u7387\u3002\r\n2.
    \u4E3B\u8981\u7ED3\u6784\r\nCFM56\u7684\u9AD8\u538B\u6DA1\u8F6E\u901A\u5E38\u91C7\u75281\u7EA7\u62162\u7EA7\u8BBE\u8BA1\uFF08\u4E0D\u540C\u5B50\u578B\u53F7\u53EF\u80FD\u7565\u6709\u5DEE\u5F02\uFF09\uFF1A\r\n\u8F6C\u5B50\u53F6\u7247\uFF08\u52A8\u53F6\uFF09\uFF1A\r\n\u6750\u6599\uFF1A\u954D\u57FA\u9AD8\u6E29\u5408\u91D1\uFF08\u5982\u5355\u6676\u6216\u5B9A\u5411\u51DD\u56FA\u5408\u91D1\uFF0C\u5982CMSX-4\uFF09\u3002\r\n\u51B7\u5374\u65B9\u5F0F\uFF1A\u6C14\u819C\u51B7\u5374+\u5185\u90E8\u5BF9\u6D41\u51B7\u5374\uFF0C\u4EE5\u627F\u53D7\u9AD8\u8FBE1,500\xB0C\u7684\u71C3\u6C14\u6E29\u5EA6\u3002\r\n\u53F6\u5C16\u53EF\u80FD\u5E26\u6709\u8010\u78E8\u6D82\u5C42\uFF08\u5982\u9676\u74F7\u6D82\u5C42\uFF09\uFF0C\u51CF\u5C11\u4E0E\u673A\u5323\u7684\u6469\u64E6\u635F\u8017\u3002\r\n\u9759\u5B50\u53F6\u7247\uFF08\u5BFC\u5411\u5668/\u55B7\u5634\uFF09\uFF1A\r\u56FA\u5B9A\u4E8E\u6DA1\u8F6E\u673A\u5323\uFF0C\u5F15\u5BFC\u9AD8\u6E29\u71C3\u6C14\u4EE5\u6700\u4F73\u89D2\u5EA6\u51B2\u51FB\u8F6C\u5B50\u53F6\u7247\u3002\r\n\u540C\u6837\u91C7\u7528\u51B7\u5374\u8BBE\u8BA1\uFF08\u5982\u5185\u90E8\u7A7A\u51B7\u6216\u6C14\u819C\u51B7\u5374\uFF09\u3002\r\n\u6DA1\u8F6E\u76D8\uFF1A\r\n\u9AD8\u5F3A\u5EA6\u5408\u91D1\uFF08\u5982Inconel718\u6216\u7C89\u672B\u51B6\u91D1\u76D8\uFF09\u5236\u9020\uFF0C\u627F\u53D7\u5DE8\u5927\u79BB\u5FC3\u529B\u548C\u70ED\u5E94\u529B\u3002\r\n\u901A\u8FC7\u69AB\u69FD\u56FA\u5B9A\u53F6\u7247\uFF0C\u5E76\u8FDE\u63A5\u81F3\u9AD8\u538B\u8F74\u3002\r\n3.
    \u51B7\u5374\u6280\u672F\r\n\u7531\u4E8E\u9AD8\u538B\u6DA1\u8F6E\u5DE5\u4F5C\u5728\u6781\u7AEF\u9AD8\u6E29\u73AF\u5883\u4E0B\uFF0CCFM56\u91C7\u7528\u5148\u8FDB\u7684\u51B7\u5374\u6280\u672F\uFF1A\r\n\u9AD8\u538B\u538B\u6C14\u673A\u5F15\u6C14\u51B7\u5374\uFF1A\u4ECE\u9AD8\u538B\u538B\u6C14\u673A\u540E\u51E0\u7EA7\u5F15\u51FA\u7684\u51B7\u7A7A\u6C14\u7528\u4E8E\u51B7\u5374\u53F6\u7247\u5185\u90E8\u901A\u9053\u3002\r\n\u6C14\u819C\u51B7\u5374\uFF1A\u51B7\u7A7A\u6C14\u4ECE\u53F6\u7247\u8868\u9762\u7684\u5C0F\u5B54\u55B7\u51FA\uFF0C\u5F62\u6210\u9694\u70ED\u5C42\uFF0C\u4FDD\u62A4\u53F6\u7247\u514D\u53D7\u9AD8\u6E29\u71C3\u6C14\u76F4\u63A5\u51B2\u5237\u3002\r\n\u51B2\u51FB\u51B7\u5374\uFF1A\u5728\u53F6\u7247\u5185\u90E8\u8BBE\u7F6E\u51B7\u5374\u6C14\u6D41\u51B2\u51FB\u901A\u9053\uFF0C\u589E\u5F3A\u6563\u70ED\u3002\r\n4.
    \u6750\u6599\u4E0E\u5236\u9020\r\n\u5355\u6676\u53F6\u7247\uFF08\u90E8\u5206\u65B0\u578B\u53F7\uFF09\uFF1A\u63D0\u9AD8\u6297\u8815\u53D8\u548C\u6297\u75B2\u52B3\u6027\u80FD\uFF0C\u5EF6\u957F\u4F7F\u7528\u5BFF\u547D\u3002\r\n\u70ED\u969C\u6D82\u5C42\uFF08TBC\uFF09\uFF1A\u5728\u53F6\u7247\u8868\u9762\u6D82\u8986\u6C27\u5316\u9506\uFF08ZrO\u2082\uFF09\u7B49\u9676\u74F7\u6750\u6599\uFF0C\u964D\u4F4E\u91D1\u5C5E\u57FA\u5E95\u6E29\u5EA6\u3002\r\n\u7C89\u672B\u51B6\u91D1\u6DA1\u8F6E\u76D8\uFF1A\u63D0\u9AD8\u6750\u6599\u5747\u5300\u6027\uFF0C\u51CF\u5C11\u7F3A\u9677\uFF0C\u589E\u5F3A\u6297\u75B2\u52B3\u80FD\u529B\u3002\r\n5.
    \u6027\u80FD\u53C2\u6570\r\n\u5DE5\u4F5C\u6E29\u5EA6\uFF1A\u8FDB\u53E3\u71C3\u6C14\u6E29\u5EA6\u53EF\u8FBE1,400\u20131,500\xB0C\uFF08\u53D6\u51B3\u4E8E\u578B\u53F7\uFF09\u3002\r\n\u8F6C\u901F\uFF1A\u4E0E\u9AD8\u538B\u538B\u6C14\u673A\u540C\u8F74\uFF0C\u8F6C\u901F\u8F83\u9AD8\uFF08\u7EA612,000\u201315,000RPM\uFF09\u3002\r\n\u6548\u7387\uFF1A\u6DA1\u8F6E\u6548\u7387\u901A\u5E38\u572885%\u201390%\uFF0C\u76F4\u63A5\u5F71\u54CD\u53D1\u52A8\u673A\u7684\u603B\u71C3\u6CB9\u6D88\u8017\u7387\uFF08TSFC\uFF09\u3002\r\n6.
    \u7EF4\u62A4\u4E0E\u5E38\u89C1\u95EE\u9898\r\n\u70ED\u75B2\u52B3\u548C\u8815\u53D8\uFF1A\u957F\u671F\u9AD8\u6E29\u5DE5\u4F5C\u53EF\u80FD\u5BFC\u81F4\u53F6\u7247\u53D8\u5F62\u6216\u88C2\u7EB9\u3002\r\n\u6D82\u5C42\u5265\u843D\uFF1A\u70ED\u969C\u6D82\u5C42\uFF08TBC\uFF09\u53EF\u80FD\u56E0\u70ED\u5FAA\u73AF\u800C\u8131\u843D\uFF0C\u9700\u5B9A\u671F\u68C0\u67E5\u3002\r\n\u8150\u8680/\u6C27\u5316\uFF1A\u9AD8\u6E29\u71C3\u6C14\u4E2D\u7684\u786B\u5316\u7269\u53EF\u80FD\u52A0\u901F\u53F6\u7247\u8150\u8680\u3002\r\n\u53F6\u5C16\u78E8\u635F\uFF1A\u4E0E\u673A\u5323\u7684\u95F4\u9699\u63A7\u5236\u81F3\u5173\u91CD\u8981\uFF0C\u8FC7\u5927\u5BFC\u81F4\u6F0F\u6C14\u635F\u5931\uFF0C\u8FC7\u5C0F\u53EF\u80FD\u6469\u64E6\u635F\u4F24\u3002\r\n7.
    \u4E0E\u5176\u4ED6\u7CFB\u7EDF\u7684\u5173\u8054\r\n\u4E0E\u71C3\u70E7\u5BA4\u8FDE\u63A5\uFF1A\u76F4\u63A5\u63A5\u6536\u71C3\u70E7\u5BA4\u6392\u51FA\u7684\u9AD8\u6E29\u71C3\u6C14\u3002\r\n\u4E0E\u9AD8\u538B\u538B\u6C14\u673A\u540C\u8F74\uFF1A\u9A71\u52A8\u9AD8\u538B\u8F6C\u5B50\uFF0C\u7EF4\u6301\u6838\u5FC3\u673A\u538B\u7F29\u6BD4\u3002\r\n\u4E0E\u4F4E\u538B\u6DA1\u8F6E\uFF08LPT\uFF09\u534F\u540C\uFF1AHPT\u63D0\u53D6\u90E8\u5206\u80FD\u91CF\u540E\uFF0C\u5269\u4F59\u80FD\u91CF\u7531LPT\u9A71\u52A8\u98CE\u6247\u3002\r\n\nCFM56\u7684\u9AD8\u538B\u6DA1\u8F6E\u662F\u53D1\u52A8\u673A\u70ED\u7AEF\u6700\u5173\u952E\u7684\u90E8\u4EF6\u4E4B\u4E00\uFF0C\u5176\u9AD8\u6548\u3001\u8010\u9AD8\u6E29\u7684\u8BBE\u8BA1\u76F4\u63A5\u5F71\u54CD\u53D1\u52A8\u673A\u7684\u63A8\u529B\u3001\u71C3\u6CB9\u7ECF\u6D4E\u6027\u548C\u5BFF\u547D\u3002\u901A\u8FC7\u5148\u8FDB\u7684\u51B7\u5374\u6280\u672F\u3001\u5355\u6676\u53F6\u7247\u548C\u70ED\u969C\u6D82\u5C42\u7684\u5E94\u7528\uFF0CCFM56\u7CFB\u5217\u5728\u53EF\u9760\u6027\u548C\u6027\u80FD\u4E4B\u95F4\u53D6\u5F97\u4E86\u826F\u597D\u5E73\u8861\uFF0C\u4F7F\u5176\u6210\u4E3A\u5546\u7528\u822A\u7A7A\u53F2\u4E0A\u6700\u6210\u529F\u7684\u53D1\u52A8\u673A\u4E4B\u4E00\u3002"
