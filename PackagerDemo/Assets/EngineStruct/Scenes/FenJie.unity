--- !u!114 &16615138
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 16615136}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: a839bd750521d0c40ba93809556be299, type: 3}
    m_FontSize: 19
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 1
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\u9AD8\u538B\u538B\u6C14\u673A\u662FCFM56\u53D1\u52A8\u673A\u7684\u6838\u5FC3\u90E8\u4EF6\u4E4B\u4E00\uFF0C\u8D1F\u8D23\u4E3A\u71C3\u70E7\u5BA4\u63D0\u4F9B\u9AD8\u538B\u7A7A\u6C14\uFF0C\u5176\u6027\u80FD\u76F4\u63A5\u5F71\u54CD\u53D1\u52A8\u673A\u7684\u63A8\u529B\u3001\u71C3\u6CB9\u6548\u7387\u548C\u53EF\u9760\u6027\u3002\r\n1.
    \u57FA\u672C\u529F\u80FD\r\n\u7A7A\u6C14\u538B\u7F29\uFF1A\u5C06\u8FDB\u6C14\u538B\u529B\u63D0\u5347\u81F3\u71C3\u70E7\u5BA4\u6240\u9700\u7684\u9AD8\u538B\u72B6\u6001\uFF08\u603B\u538B\u6BD4\u53EF\u8FBE30:1\u4EE5\u4E0A\uFF09\u3002\r\n\u6C14\u6D41\u8F93\u9001\uFF1A\u4E3A\u71C3\u70E7\u5BA4\u63D0\u4F9B\u7A33\u5B9A\u3001\u5747\u5300\u7684\u9AD8\u538B\u7A7A\u6C14\u6D41\u3002\r\n\u51B7\u5374\u6C14\u6E90\uFF1A\u63D0\u4F9B\u5F15\u6C14\u7528\u4E8E\u6DA1\u8F6E\u53F6\u7247\u51B7\u5374\u548C\u98DE\u673A\u6C14\u6E90\u7CFB\u7EDF\u3002\r\n2.
    \u7ED3\u6784\u8BBE\u8BA1\r\nCFM56\u7684\u9AD8\u538B\u538B\u6C14\u673A\u91C7\u7528\u591A\u7EA7\u8F74\u6D41\u5F0F\u8BBE\u8BA1\uFF0C\u4E0D\u540C\u5B50\u578B\u53F7\u7EA7\u6570\u7565\u6709\u5DEE\u5F02\uFF1A\r\nCFM56-3\uFF1A9\u7EA7\u9AD8\u538B\u538B\u6C14\u673A\r\nCFM56-5B/-7B\uFF1A9\u7EA7\u621610\u7EA7\uFF08\u4F18\u5316\u6548\u7387\u4E0E\u5598\u632F\u88D5\u5EA6\uFF09\r\n\u6838\u5FC3\u7EC4\u4EF6\uFF1A\r\n\u8F6C\u5B50\uFF08Rotors\uFF09\r\n\u7531\u591A\u7EA7\u6DA1\u8F6E\u76D8\u548C\u53F6\u7247\u7EC4\u6210\uFF0C\u6750\u6599\u4E3A\u9AD8\u5F3A\u5EA6\u954D\u57FA\u5408\u91D1\uFF08\u5982Inconel718\uFF09\u3002\r\n\u53F6\u7247\u91C7\u7528\u5BBD\u5F26\u8BBE\u8BA1\uFF08-5B/-7B\uFF09\uFF0C\u63D0\u5347\u6297\u98A4\u632F\u80FD\u529B\u3002\r\n\u9759\u5B50\uFF08Stators\uFF09\r\n\u56FA\u5B9A\u53F6\u7247\uFF08\u5BFC\u5411\u53F6\u7247\uFF09\uFF0C\u8C03\u8282\u6C14\u6D41\u89D2\u5EA6\uFF0C\u6BCF\u7EA7\u8F6C\u5B50\u524D\u8BBE\u7F6E\u4E00\u7EA7\u9759\u5B50\u3002\r\n\u53EF\u8C03\u9759\u5B50\uFF08VSV,
    Variable Stator Vanes\uFF09\uFF1A\u524D\u51E0\u7EA7\u9759\u53F6\u89D2\u5EA6\u53EF\u8C03\uFF0C\u9632\u6B62\u5598\u632F\u3002\r\n\u673A\u5323\uFF08Casing\uFF09\r\n\u5206\u6BB5\u5F0F\u8BBE\u8BA1\uFF0C\u91C7\u7528\u949B\u5408\u91D1\u6216\u590D\u5408\u6750\u6599\u4EE5\u51CF\u8F7B\u91CD\u91CF\u3002\r\n\u90E8\u5206\u578B\u53F7\u914D\u5907**\u4E3B\u52A8\u95F4\u9699\u63A7\u5236\uFF08ACC\uFF09**\u7CFB\u7EDF\uFF0C\u4F18\u5316\u53F6\u5C16\u95F4\u9699\u3002\r\n3.
    \u5DE5\u4F5C\u539F\u7406\r\n\u9010\u7EA7\u538B\u7F29\uFF1A\u7A7A\u6C14\u7ECF\u6BCF\u7EA7\u8F6C\u5B50\u52A0\u901F\u540E\uFF0C\u5728\u9759\u5B50\u4E2D\u51CF\u901F\u589E\u538B\uFF0C\u538B\u529B\u9010\u7EA7\u5347\u9AD8\u3002\r\n\u53EF\u8C03\u9759\u5B50\uFF08VSV\uFF09\uFF1A\u5728\u4F4E\u8F6C\u901F\u65F6\u8C03\u6574\u524D\u51E0\u7EA7\u9759\u53F6\u89D2\u5EA6\uFF0C\u907F\u514D\u6C14\u6D41\u5206\u79BB\u5BFC\u81F4\u7684\u5598\u632F\u3002\r\n\u653E\u6C14\u6D3B\u95E8\uFF08BleedValves\uFF09\uFF1A\u4E2D\u538B\u7EA7\u95F4\u8BBE\u7F6E\u653E\u6C14\u53E3\uFF0C\u9632\u6B62\u542F\u52A8\u6216\u52A0\u901F\u65F6\u5598\u632F\u3002\r\n4.
    \u5173\u952E\u6280\u672F\r\n\u5BBD\u5F26\u53F6\u7247\uFF1A\u63D0\u5347\u6C14\u52A8\u6548\u7387\uFF0C\u51CF\u5C11\u4E8C\u6B21\u6D41\u635F\u5931\uFF08-5B/-7B\u91C7\u7528\uFF09\u3002\r\n\u4E09\u7EF4\u6C14\u52A8\u8BBE\u8BA1\uFF1A\u4F18\u5316\u53F6\u7247\u578B\u9762\uFF0C\u63D0\u9AD8\u538B\u6BD4\u548C\u6548\u7387\u3002\r\n\u4E3B\u52A8\u95F4\u9699\u63A7\u5236\uFF08ACC\uFF09\uFF1A\u901A\u8FC7\u51B7\u5374\u7A7A\u6C14\u8C03\u8282\u673A\u5323\u70ED\u81A8\u80C0\uFF0C\u51CF\u5C11\u53F6\u5C16\u6F0F\u6C14\u3002\r\n5.
    \u6027\u80FD\u53C2\u6570\r\n\u538B\u6BD4\uFF1A\u5355\u53F0\u9AD8\u538B\u538B\u6C14\u673A\u538B\u6BD4\u7EA612:1\uFF08\u4E0E\u4F4E\u538B\u538B\u6C14\u673A\u7EC4\u5408\u603B\u538B\u6BD4\u8FBE30:1\u4EE5\u4E0A\uFF09\u3002\r\n\u8F6C\u901F\uFF1A\u9AD8\u538B\u8F6C\u5B50\u8F6C\u901F\u7EA610,000\u201315,000RPM\uFF08\u4E0E\u9AD8\u538B\u6DA1\u8F6E\u540C\u8F74\uFF09\u3002\r\n\u6548\u7387\uFF1A\u7EDD\u70ED\u6548\u7387\u8D85\u8FC785%\uFF0C\u76F4\u63A5\u5F71\u54CD\u53D1\u52A8\u673A\u71C3\u6CB9\u7ECF\u6D4E\u6027\u3002\r\n6.
    \u6750\u6599\u4E0E\u5236\u9020\r\n\u53F6\u7247\uFF1A\u949B\u5408\u91D1\uFF08\u524D\u7EA7\uFF09\u548C\u954D\u57FA\u5408\u91D1\uFF08\u540E\u7EA7\u9AD8\u6E29\u6BB5\uFF09\u3002\r\n\u6DA1\u8F6E\u76D8\uFF1A\u7C89\u672B\u51B6\u91D1\u5408\u91D1\uFF08\u5982ME16\uFF09\uFF0C\u51CF\u8F7B\u91CD\u91CF\u5E76\u63D0\u9AD8\u5F3A\u5EA6\u3002\r\n\u6D82\u5C42\uFF1A\u53F6\u7247\u524D\u7F18\u55B7\u6D82\u8010\u78E8\u6D82\u5C42\uFF08\u5982AlCrN\uFF09\uFF0C\u9632\u6B62\u8150\u8680\u548C\u78E8\u635F\u3002\r\n7.
    \u7EF4\u62A4\u4E0E\u5E38\u89C1\u95EE\u9898\r\n\u53F6\u7247\u78E8\u635F\uFF1A\u5438\u5165\u5F02\u7269\uFF08FOD\uFF09\u53EF\u80FD\u5BFC\u81F4\u524D\u7EA7\u53F6\u7247\u635F\u4F24\u3002\r\n\u5598\u632F\uFF1AVSV\u7CFB\u7EDF\u6545\u969C\u6216\u653E\u6C14\u6D3B\u95E8\u5361\u6EDE\u53EF\u80FD\u5F15\u53D1\u5598\u632F\u3002\r\n\u8150\u8680\uFF1A\u9AD8\u6E7F\u5EA6\u6216\u76D0\u96FE\u73AF\u5883\u52A0\u901F\u949B\u5408\u91D1\u53F6\u7247\u8150\u8680\u3002\r\n\u53F6\u5C16\u95F4\u9699\u8FC7\u5927\uFF1A\u5BFC\u81F4\u6F0F\u6C14\u635F\u5931\uFF0C\u9700\u901A\u8FC7ACC\u7CFB\u7EDF\u6216\u7EF4\u4FEE\u8C03\u6574\u3002\r\n8.
