--- !u!114 &1643114542
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1643114540}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: a839bd750521d0c40ba93809556be299, type: 3}
    m_FontSize: 19
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 1
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "CFM56\u53D1\u52A8\u673A\u7684\u4F4E\u538B\u8F74\uFF08Low-PressureSpool,LPSpool\uFF09\u662F\u53CC\u8F6C\u5B50\u7ED3\u6784\u4E2D\u7684\u5173\u952E\u7EC4\u4EF6\u4E4B\u4E00\uFF0C\u8D1F\u8D23\u9A71\u52A8\u98CE\u6247\u548C\u4F4E\u538B\u538B\u6C14\u673A\uFF0C\u5E76\u901A\u8FC7\u4F4E\u538B\u6DA1\u8F6E\u63D0\u53D6\u80FD\u91CF\u4EE5\u4EA7\u751F\u63A8\u529B\u3002\u4EE5\u4E0B\u662F\u5176\u6838\u5FC3\u7279\u70B9\u53CA\u529F\u80FD\u7684\u8BE6\u7EC6\u4ECB\u7ECD\uFF1A\r\n1.
    \u7EC4\u6210\u7ED3\u6784\r\n\u98CE\u6247\uFF08Fan\uFF09\uFF1A\u5355\u7EA7\u5927\u76F4\u5F84\u98CE\u6247\uFF08\u76F4\u5F84\u7EA61.5\u20131.8\u7C73\uFF0C\u89C6\u578B\u53F7\u800C\u5B9A\uFF09\uFF0C\u76F4\u63A5\u7531\u4F4E\u538B\u8F74\u9A71\u52A8\uFF0C\u63D0\u4F9B\u7EA680%\u7684\u53D1\u52A8\u673A\u603B\u63A8\u529B\uFF08\u65C1\u901A\u6C14\u6D41\uFF09\u3002\r\n\u4F4E\u538B\u538B\u6C14\u673A\uFF08LPC\uFF09\uFF1A\u901A\u5E38\u4E3A3\u20134\u7EA7\uFF0C\u8FDB\u4E00\u6B65\u538B\u7F29\u8FDB\u5165\u6838\u5FC3\u673A\u7684\u7A7A\u6C14\u3002\r\n\u4F4E\u538B\u6DA1\u8F6E\uFF08LPT\uFF09\uFF1A\u901A\u5E38\u4E3A4\u20135\u7EA7\uFF0C\u901A\u8FC7\u71C3\u6C14\u80FD\u91CF\u9A71\u52A8\u98CE\u6247\u548C\u4F4E\u538B\u538B\u6C14\u673A\u3002\r\n\u4F4E\u538B\u8F74\uFF08LPShaft\uFF09\uFF1A\u8FDE\u63A5\u98CE\u6247\u3001\u4F4E\u538B\u538B\u6C14\u673A\u548C\u4F4E\u538B\u6DA1\u8F6E\u7684\u540C\u5FC3\u8F74\uFF0C\u4E0E\u9AD8\u538B\u8F74\u5D4C\u5957\u4F46\u72EC\u7ACB\u65CB\u8F6C\u3002\r\n2.
    \u5DE5\u4F5C\u7279\u70B9\r\n\u8F6C\u901F\u8F83\u4F4E\uFF1A\u4F4E\u538B\u8F74\u8F6C\u901F\u901A\u5E38\u4E3A3,000\u20135,000RPM\uFF08\u8FDC\u4F4E\u4E8E\u9AD8\u538B\u8F74\uFF09\uFF0C\u4F46\u626D\u77E9\u66F4\u5927\uFF08\u56E0\u9A71\u52A8\u5927\u5C3A\u5BF8\u98CE\u6247\uFF09\u3002\r\n\u9AD8\u63A8\u529B\u8D21\u732E\uFF1A\u98CE\u6247\u4EA7\u751F\u7684\u65C1\u901A\u6C14\u6D41\uFF08BypassFlow\uFF09\u662FCFM56\u9AD8\u6DB5\u9053\u6BD4\uFF085:1\u20136:1\uFF09\u63A8\u529B\u7684\u4E3B\u8981\u6765\u6E90\u3002\r\n\u6E29\u5EA6\u8F83\u4F4E\uFF1A\u76F8\u6BD4\u9AD8\u538B\u6DA1\u8F6E\uFF0C\u4F4E\u538B\u6DA1\u8F6E\u5DE5\u4F5C\u6E29\u5EA6\u8F83\u4F4E\uFF08\u7EA6600\u2013800\xB0C\uFF09\uFF0C\u4F46\u4ECD\u9700\u8010\u70ED\u5408\u91D1\u3002\r\n3.
    \u6750\u6599\u4E0E\u5236\u9020\r\n\u6750\u6599\uFF1A\r\n\u8F74\u4F53\uFF1A\u9AD8\u5F3A\u5EA6\u94A2\u6216\u949B\u5408\u91D1\uFF08\u5982Ti-6Al-4V\uFF09\uFF0C\u517C\u987E\u8F7B\u91CF\u5316\u548C\u6297\u75B2\u52B3\u6027\u80FD\u3002\r\n\u6DA1\u8F6E\u53F6\u7247\uFF1A\u954D\u57FA\u5408\u91D1\uFF08\u5982\u5B9A\u5411\u51DD\u56FA\u5408\u91D1\uFF09\uFF0C\u53EF\u80FD\u5E26\u51B7\u5374\u5B54\u3002\r\n\u8F74\u627F\u652F\u6301\uFF1A\u901A\u8FC7\u524D\u3001\u540E\u652F\u70B9\u8F74\u627F\uFF08\u5982\u6EDA\u73E0\u8F74\u627F\u548C\u6EDA\u67F1\u8F74\u627F\uFF09\u652F\u6491\uFF0C\u786E\u4FDD\u9AD8\u901F\u65CB\u8F6C\u7A33\u5B9A\u6027\u3002\r\n4.
    \u5728CFM56\u4E2D\u7684\u529F\u80FD\r\n\u63A8\u8FDB\u6548\u7387\u6838\u5FC3\uFF1A\r\n\u5927\u76F4\u5F84\u98CE\u6247\u63D0\u4F9B\u9AD8\u6DB5\u9053\u6BD4\u63A8\u529B\uFF0C\u964D\u4F4E\u71C3\u6CB9\u6D88\u8017\u548C\u566A\u97F3\u3002\r\n\u4F4E\u538B\u6DA1\u8F6E\u9AD8\u6548\u63D0\u53D6\u80FD\u91CF\uFF0C\u9A71\u52A8\u98CE\u6247\u548C\u4F4E\u538B\u538B\u6C14\u673A\u3002\r\n\u53CC\u8F6C\u5B50\u4F18\u52BF\uFF1A\r\n\u4F4E\u538B\u8F74\u4E0E\u9AD8\u538B\u8F74\uFF08\u9AD8\u538B\u538B\u6C14\u673A+\u9AD8\u538B\u6DA1\u8F6E\uFF09\u72EC\u7ACB\u8FD0\u8F6C\uFF0C\u4F18\u5316\u4E0D\u540C\u5DE5\u51B5\u4E0B\u7684\u6548\u7387\uFF08\u5982\u8D77\u98DE\u3001\u5DE1\u822A\uFF09\u3002\r\n5.
