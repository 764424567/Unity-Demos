--- !u!114 &1404641398
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1404641396}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: a839bd750521d0c40ba93809556be299, type: 3}
    m_FontSize: 19
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 1
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "CFM56\u53D1\u52A8\u673A\u7684\u9AD8\u538B\u8F74\uFF08High-Pressure\u3000Spool\uFF09\u662F\u5176\u6838\u5FC3\u90E8\u4EF6\u4E4B\u4E00\uFF0C\u8D1F\u8D23\u9A71\u52A8\u9AD8\u538B\u538B\u6C14\u673A\u548C\u9AD8\u538B\u6DA1\u8F6E\uFF0C\u662F\u4FDD\u8BC1\u53D1\u52A8\u673A\u9AD8\u6548\u8FD0\u884C\u7684\u5173\u952E\u7EC4\u4EF6\u3002\u4EE5\u4E0B\u662F\u5176\u6838\u5FC3\u7279\u70B9\u53CA\u529F\u80FD\u7684\u7B80\u4ECB\uFF1A\r\n1.
    \u7EC4\u6210\u7ED3\u6784\r\n\u9AD8\u538B\u538B\u6C14\u673A\uFF08HPC\uFF09\uFF1A\u901A\u5E38\u75319-12\u7EA7\u7EC4\u6210\uFF0C\u5C06\u5438\u5165\u7684\u7A7A\u6C14\u9010\u7EA7\u538B\u7F29\uFF0C\u63D0\u5347\u538B\u529B\u548C\u6E29\u5EA6\uFF0C\u4F9B\u71C3\u70E7\u5BA4\u4F7F\u7528\u3002\r\n\u9AD8\u538B\u6DA1\u8F6E\uFF08HPT\uFF09\uFF1A\u901A\u5E38\u4E3A1-2\u7EA7\uFF0C\u901A\u8FC7\u71C3\u70E7\u540E\u7684\u9AD8\u6E29\u71C3\u6C14\u9A71\u52A8\uFF0C\u5C06\u70ED\u80FD\u8F6C\u5316\u4E3A\u673A\u68B0\u80FD\uFF0C\u5E26\u52A8\u9AD8\u538B\u538B\u6C14\u673A\u65CB\u8F6C\u3002\r\n\u9AD8\u538B\u8F74\uFF08HPShaft\uFF09\uFF1A\u8FDE\u63A5\u9AD8\u538B\u538B\u6C14\u673A\u4E0E\u9AD8\u538B\u6DA1\u8F6E\u7684\u521A\u6027\u8F74\uFF0C\u4F20\u9012\u626D\u77E9\u548C\u8F6C\u901F\u3002\r\n2.
    \u5DE5\u4F5C\u7279\u70B9\r\n\u9AD8\u8F6C\u901F\uFF1A\u9AD8\u538B\u8F74\u8F6C\u901F\u53EF\u8FBE15,000RPM\u4EE5\u4E0A\uFF08\u5177\u4F53\u56E0\u578B\u53F7\u800C\u5F02\uFF09\uFF0C\u9700\u627F\u53D7\u6781\u5927\u79BB\u5FC3\u529B\u3002\r\n\u9AD8\u6E29\u73AF\u5883\uFF1A\u9AD8\u538B\u6DA1\u8F6E\u7AEF\u5DE5\u4F5C\u6E29\u5EA6\u8D85\u8FC71000\xB0C\uFF0C\u6750\u6599\u9700\u5177\u5907\u8010\u9AD8\u6E29\u6027\u80FD\uFF08\u5982\u954D\u57FA\u5408\u91D1\uFF09\u3002\r\n\u673A\u68B0\u8D1F\u8F7D\uFF1A\u627F\u53D7\u9AD8\u538B\u538B\u6C14\u673A\u7684\u538B\u7F29\u53CD\u4F5C\u7528\u529B\u548C\u6DA1\u8F6E\u7684\u9A71\u52A8\u626D\u77E9\u3002\r\n3.
    \u6750\u6599\u4E0E\u5236\u9020\r\n\u6750\u6599\uFF1A\u91C7\u7528\u9AD8\u5F3A\u5EA6\u3001\u8010\u9AD8\u6E29\u5408\u91D1\uFF08\u5982Inconel718\uFF09\uFF0C\u5E76\u53EF\u80FD\u5E94\u7528\u70ED\u969C\u6D82\u5C42\uFF08TBC\uFF09\u4EE5\u51CF\u5C11\u70ED\u5E94\u529B\u3002\r\n\u51B7\u5374\u8BBE\u8BA1\uFF1A\u9AD8\u538B\u6DA1\u8F6E\u53F6\u7247\u548C\u8F74\u90E8\u5206\u533A\u57DF\u91C7\u7528\u5185\u90E8\u7A7A\u6C14\u51B7\u5374\uFF0C\u4EE5\u5EF6\u957F\u5BFF\u547D\u3002\r\n4.
    \u5728CFM56\u4E2D\u7684\u89D2\u8272\r\n\u6838\u5FC3\u52A8\u529B\u6765\u6E90\uFF1A\u9AD8\u538B\u8F74\u4E0E\u4F4E\u538B\u8F74\uFF08\u4F4E\u538B\u538B\u6C14\u673A+\u4F4E\u538B\u6DA1\u8F6E\uFF09\u534F\u540C\u5DE5\u4F5C\uFF0C\u6784\u6210\u53CC\u8F6C\u5B50\u8BBE\u8BA1\uFF0C\u63D0\u5347\u53D1\u52A8\u673A\u6548\u7387\u3002\r\n\u71C3\u6CB9\u6548\u7387\u5173\u952E\uFF1A\u9AD8\u538B\u538B\u6C14\u673A\u7684\u9AD8\u538B\u7F29\u6BD4\uFF08\u7EA630:1\uFF09\u663E\u8457\u5F71\u54CD\u71C3\u70E7\u6548\u7387\u548C\u63A8\u529B\u8F93\u51FA\u3002\r\n5.
    \u7EF4\u62A4\u4E0E\u6545\u969C\u70B9\r\n\u5E38\u89C1\u95EE\u9898\uFF1A\u9AD8\u6E29\u8815\u53D8\u3001\u75B2\u52B3\u88C2\u7EB9\u3001\u8F74\u627F\u78E8\u635F\uFF08\u5982\u9AD8\u538B\u8F6C\u5B50\u8F74\u627F\uFF09\u3002\r\n\u7EF4\u62A4\u91CD\u70B9\uFF1A\u5B9A\u671F\u68C0\u67E5\u8F74\u7684\u5BF9\u4E2D\u6027\u3001\u632F\u52A8\u503C\uFF0C\u4EE5\u53CA\u6DA1\u8F6E\u53F6\u7247\u7684\u8150\u8680/\u78E8\u635F\u60C5\u51B5\u3002"
