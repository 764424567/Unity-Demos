--- !u!114 &192126048
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 192126046}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: a839bd750521d0c40ba93809556be299, type: 3}
    m_FontSize: 19
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 1
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "CFM56\u53D1\u52A8\u673A\u7684\u4F4E\u538B\u6DA1\u8F6E\uFF08LPT\uFF0CLow-Pressure\u3000Turbine\uFF09\u662F\u5176\u6838\u5FC3\u90E8\u4EF6\u4E4B\u4E00\uFF0C\u8D1F\u8D23\u9A71\u52A8\u4F4E\u538B\u538B\u6C14\u673A\uFF08\u98CE\u6247\uFF09\u548C\u63D0\u53D6\u80FD\u91CF\u4EE5\u4EA7\u751F\u63A8\u529B\u3002\u4EE5\u4E0B\u662F\u5176\u5173\u952E\u7279\u70B9\u548C\u5DE5\u4F5C\u539F\u7406\u7684\u7B80\u4ECB\uFF1A\r\n1.
    \u57FA\u672C\u529F\u80FD\r\n\u80FD\u91CF\u8F6C\u6362\uFF1A\u5C06\u9AD8\u6E29\u9AD8\u538B\u71C3\u6C14\u7684\u80FD\u91CF\u8F6C\u5316\u4E3A\u673A\u68B0\u80FD\uFF0C\u9A71\u52A8\u4F4E\u538B\u8F74\uFF08\u8FDE\u63A5\u4F4E\u538B\u538B\u6C14\u673A\u548C\u98CE\u6247\uFF09\u3002\r\n\u63A8\u529B\u751F\u6210\uFF1A\u901A\u8FC7\u9A71\u52A8\u98CE\u6247\u4EA7\u751F\u7EA680%\u7684\u603B\u63A8\u529B\uFF08\u65C1\u901A\u6C14\u6D41\u4E3A\u4E3B\uFF09\u3002\r\n\u8F6C\u901F\u63A7\u5236\uFF1A\u4E0E\u4F4E\u538B\u538B\u6C14\u673A\u540C\u8F74\uFF0C\u8F6C\u901F\u8F83\u4F4E\uFF08\u7EA63000-5000RPM\uFF09\uFF0C\u786E\u4FDD\u9AD8\u6548\u7684\u6C14\u52A8\u5339\u914D\u3002\r\n2.
    \u4E3B\u8981\u7ED3\u6784\r\n\u7EA7\u6570\uFF1A\u901A\u5E38\u4E3A4-5\u7EA7\uFF08\u5982CFM56-5B\u4E3A4\u7EA7\uFF0C-7B\u4E3A5\u7EA7\uFF09\uFF0C\u7EA7\u6570\u8BBE\u8BA1\u5E73\u8861\u6548\u7387\u4E0E\u91CD\u91CF\u3002\r\n\u8F6C\u5B50\u53F6\u7247\uFF1A\u954D\u57FA\u5408\u91D1\u5236\u9020\uFF0C\u5E26\u51B7\u5374\u5B54\uFF08\u524D\u51E0\u7EA7\u53EF\u80FD\u91C7\u7528\u6C14\u819C\u51B7\u5374\uFF09\uFF0C\u8010\u53D7\u7EA61000\xB0C\u9AD8\u6E29\u3002\r\n\u9759\u5B50\u53F6\u7247\uFF08\u5BFC\u5411\u5668\uFF09\uFF1A\u5F15\u5BFC\u71C3\u6C14\u6D41\u81F3\u4E0B\u4E00\u7EA7\u8F6C\u5B50\uFF0C\u4F18\u5316\u6C14\u6D41\u89D2\u5EA6\u3002\r\n\u6DA1\u8F6E\u76D8\uFF1A\u9AD8\u5F3A\u5EA6\u5408\u91D1\u5236\u6210\uFF0C\u901A\u8FC7\u69AB\u69FD\u56FA\u5B9A\u53F6\u7247\uFF0C\u627F\u53D7\u5DE8\u5927\u79BB\u5FC3\u529B\u3002\r\n3.
    \u51B7\u5374\u6280\u672F\r\n\u5185\u90E8\u7A7A\u6C14\u51B7\u5374\uFF1A\u9AD8\u538B\u538B\u6C14\u673A\u5F15\u6C14\u51B7\u5374\u53F6\u7247\u5185\u90E8\uFF08\u5BF9\u6D41/\u51B2\u51FB\u51B7\u5374\uFF09\u3002\r\n\u6C14\u819C\u51B7\u5374\uFF1A\u51B7\u7A7A\u6C14\u4ECE\u53F6\u7247\u8868\u9762\u5C0F\u5B54\u55B7\u51FA\uFF0C\u5F62\u6210\u4FDD\u62A4\u819C\u9694\u79BB\u9AD8\u6E29\u71C3\u6C14\u3002\r\n4.
    \u6750\u6599\u4E0E\u5236\u9020\r\n\u9AD8\u6E29\u5408\u91D1\uFF1A\u5982INCONEL718\uFF08\u53F6\u7247\uFF09\u548C\u7C89\u672B\u51B6\u91D1\u76D8\uFF08\u51CF\u8F7B\u91CD\u91CF\uFF09\u3002\r\n\u5355\u6676\u53F6\u7247\uFF08\u90E8\u5206\u578B\u53F7\uFF09\uFF1A\u63D0\u9AD8\u6297\u8815\u53D8\u6027\u80FD\uFF0C\u5EF6\u957F\u5BFF\u547D\u3002\r\n5.
    \u6027\u80FD\u53C2\u6570\r\n\u538B\u6BD4\uFF1A\u4E0E\u9AD8\u538B\u6DA1\u8F6E\u534F\u540C\uFF0C\u603B\u538B\u6BD4\u53EF\u8FBE30:1\u4EE5\u4E0A\u3002\r\n\u6548\u7387\uFF1A\u7EA685%-90%\uFF0C\u5F71\u54CD\u53D1\u52A8\u673A\u6574\u4F53\u71C3\u6CB9\u7ECF\u6D4E\u6027\u3002\r\n\u63A8\u529B\u8D21\u732E\uFF1A\u95F4\u63A5\u901A\u8FC7\u9A71\u52A8\u98CE\u6247\u4EA7\u751F\u9AD8\u65C1\u901A\u6BD4\u63A8\u529B\uFF08\u5982CFM56-7B\u6700\u5927\u63A8\u529B\u7EA627,300
    lbf\uFF09\u3002\r\n6. \u7EF4\u62A4\u8981\u70B9\r\n\u70ED\u75B2\u52B3\u68C0\u67E5\uFF1A\u5B9A\u671F\u68C0\u6D4B\u53F6\u7247\u88C2\u7EB9\u548C\u6D82\u5C42\u8131\u843D\u3002\r\n\u8150\u8680\u9632\u62A4\uFF1A\u7279\u522B\u662F\u5728\u9AD8\u786B\u71C3\u6599\u4F7F\u7528\u73AF\u5883\u4E2D\u3002\r\n\u95F4\u9699\u63A7\u5236\uFF1A\u786E\u4FDD\u53F6\u5C16\u4E0E\u673A\u5323\u95F4\u9699\u4F18\u5316\uFF0C\u9632\u6B62\u6F0F\u6C14\u635F\u5931\u6548\u7387\u3002\r\n7.
    \u4E0E\u5176\u4ED6\u7CFB\u7EDF\u7684\u5173\u8054\r\n\u4E0E\u9AD8\u538B\u6DA1\u8F6E\u534F\u540C\uFF1A\u9AD8\u538B\u6DA1\u8F6E\u9A71\u52A8\u9AD8\u538B\u538B\u6C14\u673A\uFF0C\u4F4E\u538B\u6DA1\u8F6E\u4E13\u6CE8\u98CE\u6247\u9A71\u52A8\uFF0C\u5206\u5DE5\u660E\u786E\u3002\r\n\u53CD\u63A8\u88C5\u7F6E\uFF1A\u90E8\u5206\u578B\u53F7\u4F4E\u538B\u6DA1\u8F6E\u6392\u6C14\u6BB5\u53EF\u80FD\u96C6\u6210\u53CD\u63A8\u6C14\u6D41\u901A\u9053\u3002\r\nCFM56\u7CFB\u5217\u7684\u4F4E\u538B\u6DA1\u8F6E\u8BBE\u8BA1\u4F53\u73B0\u4E86\u9AD8\u65C1\u901A\u6BD4\u6DA1\u6247\u53D1\u52A8\u673A\u7684\u5178\u578B\u7279\u5F81\uFF0C\u517C\u987E\u6548\u7387\u4E0E\u53EF\u9760\u6027\uFF0C\u662F\u5176\u6210\u4E3A\u6C11\u822A\u4E3B\u529B\u53D1\u52A8\u673A\u7684\u5173\u952E\u4E4B\u4E00\u3002"
